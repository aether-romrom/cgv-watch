        "rules": [
          {
            "_label": "주말은 아침~밤",
            "weekdays": [
              "토",
              "일"
            ],
            "time_from": "0800",
            "time_to": "2359"
          },
          {
            "_label": "평일은 저녁 6시부터",
            "weekdays": [
              "월",
              "화",
              "수",
              "목",
              "금"
            ],
            "time_from": "1800",
            "time_to": "2359"
          }
        ]
      }
    }
  ],
  "notify": {
    "new_showtime": true,
    "seats_freed": true,
    "seats_freed_when_prev_at_or_below": 20,
