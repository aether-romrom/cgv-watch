  "_note": "알림 주소(NTFY_TOPIC)는 여기 두지 않는다. 맥은 launchd plist, GitHub Actions는 Secrets로 주입한다.",
  "ntfy_server": "https://ntfy.sh",
  "targets": [
    {
      "label": "오디세이 · 용산 IMAX",
